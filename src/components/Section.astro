---
interface Props {
  label: string;
  action?: { label: string; href: string };
}
const { label, action } = Astro.props;
---

<section class="mt-12">
  <div class="flex items-baseline justify-between">
    <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-faint">{label}</h2>
    {
      action && (
        <a
          href={action.href}
          class="text-xs text-muted transition-colors hover:text-accent"
        >
          {action.label}
        </a>
      )
    }
  </div>
  <div class="mt-3 divide-y divide-rule">
    <slot />
  </div>
</section>
