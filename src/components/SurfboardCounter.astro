---
import { site } from '../data/site';

const api = site.counterApiUrl;
---

<section aria-label="Surfboard counter" data-counter data-api={api} class="mt-16 border-t border-rule pt-8">
  <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-faint">counter</h2>
  <div class="mt-4 flex items-center gap-6">
    <svg viewBox="0 0 40 100" width="40" height="100" class="shrink-0" aria-hidden="true">
      <rect x="4" y="2" width="32" height="96" rx="16" fill="var(--color-accent)" />
      <line x1="20" y1="6" x2="20" y2="94" stroke="white" stroke-width="1" stroke-opacity="0.6" />
    </svg>

    <div class="min-w-0">
      {
        api ? (
          <>
            <p class="text-sm text-ink">
              <span data-count class="text-2xl font-semibold tabular-nums text-ink">0</span>
              <span class="text-sm text-muted"> waves surfed</span>
            </p>
            <button
              type="button"
              data-add
              class="mt-3 rounded-md bg-accent px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-dark"
              >Send a wave</button
            >
          </>
        ) : (
          <p class="text-sm text-muted">Counter is offline.</p>
        )
      }
    </div>
  </div>
</section>

<script>
  function initCounter() {
    const root = document.querySelector('[data-counter]');
    if (!(root instanceof HTMLElement)) return;

    const api = root.dataset.api || '';
    if (!api) return;

    const btn = root.querySelector('[data-add]');
    const countEl = root.querySelector('[data-count]');

    fetch(`${api}/count`)
      .then((r) => r.json())
      .then((d) => {
        if (countEl) countEl.textContent = String(Number(d.count) || 0);
      })
      .catch(() => {});

    btn?.addEventListener('click', () => {
      fetch(`${api}/increment`, { method: 'POST' })
        .then((r) => r.json())
        .then((d) => {
          if (countEl) countEl.textContent = String(Number(d.count) || 0);
        })
        .catch(() => {});
    });
  }

  document.addEventListener('DOMContentLoaded', initCounter);
</script>
