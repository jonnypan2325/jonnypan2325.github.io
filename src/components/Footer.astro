---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-[38rem] px-6 pb-16 pt-10">
  <div
    class="flex flex-col gap-3 border-t border-rule pt-6 text-sm text-muted sm:flex-row sm:items-center sm:justify-between"
  >
    <p>{year} {site.name}</p>
    <ul class="flex gap-4">
      {
        site.links.map((l) => (
          <li>
            {/* rel="me" claims these profiles as the same person, mirroring the
                `sameAs` array in the JSON-LD Person node in Base.astro. */}
            <a
              href={l.href}
              rel="me noopener noreferrer"
              target="_blank"
              class="transition-colors hover:text-accent"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
