---
import { site } from '../data/site';

const api = site.counterApiUrl;
const siteKey = site.turnstileSiteKey;
const active = Boolean(api && siteKey);
---

<section aria-label="Wave counter" data-wave data-api={api} data-sitekey={siteKey} class="mt-16 border-t border-rule pt-8">
  <h2 class="text-[11px] font-semibold uppercase tracking-[0.18em] text-faint">waves</h2>
  <div class="mt-4 flex items-center gap-6">
    <svg
      viewBox="0 0 120 80"
      width="120"
      height="80"
      class="shrink-0"
      aria-hidden="true"
      style="shape-rendering: crispEdges;"
    >
      <g data-wave-idle>
        <rect x="0" y="44" width="120" height="36" fill="#dff1fb"></rect>
        <g fill="#9fd0ea">
          <rect x="6" y="50" width="8" height="3"></rect>
          <rect x="26" y="50" width="8" height="3"></rect>
          <rect x="46" y="50" width="8" height="3"></rect>
          <rect x="66" y="50" width="8" height="3"></rect>
          <rect x="86" y="50" width="8" height="3"></rect>
          <rect x="106" y="50" width="8" height="3"></rect>
        </g>
        <g fill="var(--color-accent)">
          <rect x="16" y="58" width="8" height="3"></rect>
          <rect x="36" y="58" width="8" height="3"></rect>
          <rect x="56" y="58" width="8" height="3"></rect>
          <rect x="76" y="58" width="8" height="3"></rect>
          <rect x="96" y="58" width="8" height="3"></rect>
        </g>
        <g fill="#9fd0ea">
          <rect x="6" y="66" width="8" height="3"></rect>
          <rect x="26" y="66" width="8" height="3"></rect>
          <rect x="46" y="66" width="8" height="3"></rect>
          <rect x="66" y="66" width="8" height="3"></rect>
          <rect x="86" y="66" width="8" height="3"></rect>
          <rect x="106" y="66" width="8" height="3"></rect>
        </g>
        <g fill="#7cc3e8">
          <rect x="16" y="72" width="8" height="3"></rect>
          <rect x="36" y="72" width="8" height="3"></rect>
          <rect x="56" y="72" width="8" height="3"></rect>
          <rect x="76" y="72" width="8" height="3"></rect>
          <rect x="96" y="72" width="8" height="3"></rect>
        </g>
      </g>
      <g data-wave-active fill="var(--color-accent)" style="display: none;">
        <!-- calm water -->
        <rect x="0" y="66" width="120" height="14" fill="#cfeafb"></rect>
        <!-- wave body: peak on the right, face sloping down to the left -->
        <rect x="36" y="58" width="80" height="8"></rect>
        <rect x="42" y="50" width="74" height="8"></rect>
        <rect x="50" y="42" width="66" height="8"></rect>
        <rect x="60" y="34" width="56" height="8"></rect>
        <rect x="72" y="26" width="44" height="8"></rect>
        <rect x="84" y="20" width="28" height="6"></rect>
        <!-- lip curling left over the barrel -->
        <rect x="58" y="18" width="40" height="6"></rect>
        <!-- hollow barrel under the lip -->
        <rect x="60" y="26" width="22" height="8" fill="#cfeafb"></rect>
        <!-- lighter face highlight -->
        <rect x="44" y="50" width="26" height="4" fill="#6fb7e0"></rect>
        <rect x="50" y="44" width="22" height="3" fill="#6fb7e0"></rect>
        <!-- surfer on the face -->
        <rect x="48" y="52" width="18" height="3" fill="#f4b63f"></rect>
        <rect x="52" y="45" width="12" height="2" fill="#16324a"></rect>
        <rect x="56" y="44" width="3" height="8" fill="#16324a"></rect>
        <rect x="55" y="39" width="4" height="4" fill="#f0c290"></rect>
        <!-- white foam crest and spray -->
        <rect x="56" y="12" width="46" height="6" fill="#ffffff"></rect>
        <rect x="50" y="18" width="12" height="6" fill="#ffffff"></rect>
        <rect x="44" y="22" width="5" height="4" fill="#ffffff"></rect>
        <rect x="38" y="28" width="4" height="3" fill="#ffffff"></rect>
        <rect x="33" y="34" width="4" height="3" fill="#ffffff"></rect>
        <rect x="34" y="58" width="12" height="3" fill="#ffffff"></rect>
        <rect x="48" y="62" width="12" height="3" fill="#ffffff"></rect>
      </g>
    </svg>

    <div class="min-w-0">
      <p class="text-sm text-ink">Send a wave at me. I surf, so send one my way.</p>
      <p class="mt-1">
        <span data-count class="text-2xl font-semibold tabular-nums text-ink">0</span>
        <span class="text-sm text-muted"> waves surfed</span>
      </p>
      <button
        type="button"
        data-add
        disabled
        class="mt-3 rounded-md bg-accent px-3.5 py-1.5 text-sm font-medium text-white transition-colors hover:bg-accent-dark disabled:cursor-not-allowed disabled:opacity-50"
        >Send a wave</button
      >
      <!-- Turnstile renders here only if it decides a challenge is needed. -->
      <div data-turnstile class="mt-3 empty:hidden"></div>
      <p
        data-popup
        hidden
        role="status"
        class="mt-2 rounded-md border border-rule bg-white px-3 py-1.5 text-xs text-ink"
      >
        HEY! You've already sent me a wave, don't wipe me out!
      </p>
      <p data-status class="mt-2 text-xs text-muted" aria-live="polite"></p>
      <p data-count-sr class="sr-only" aria-live="polite"></p>
      <p class="mt-1 text-xs text-faint">Please don't drown me (. _.)</p>
    </div>
  </div>
</section>

{
  active && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit"
      async
      defer
    />
  )
}

<script>
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    execute: (id?: string) => void;
    reset: (id?: string) => void;
  };

  function initWaveCounter() {
    const w = window as unknown as { turnstile?: Turnstile };
    const root = document.querySelector('[data-wave]');
    if (!(root instanceof HTMLElement)) return;

    const api = root.dataset.api || '';
    const siteKey = root.dataset.sitekey || '';
    const btn = root.querySelector('[data-add]');
    const countEl = root.querySelector('[data-count]');
    const status = root.querySelector('[data-status]');
    const countSr = root.querySelector('[data-count-sr]');
    const idle = root.querySelector('[data-wave-idle]');
    const wave = root.querySelector('[data-wave-active]');
    const popup = root.querySelector('[data-popup]');
    const tsContainer = root.querySelector('[data-turnstile]');
    const COOLDOWN_MS = 15 * 60 * 1000;
    const KEY = 'wave-cooldown-until';
    let sending = false;
    let popupTimer = 0;
    let widgetId: string | null = null;

    const setCount = (n: number) => {
      const s = String(n);
      if (countEl) countEl.textContent = s;
      if (countSr) countSr.textContent = `Current wave count: ${s}.`;
    };

    const showRidingWave = () => {
      if (idle instanceof SVGElement) idle.style.display = 'none';
      if (wave instanceof SVGElement) wave.style.display = '';
    };

    const showPopup = () => {
      if (!(popup instanceof HTMLElement)) return;
      popup.hidden = false;
      clearTimeout(popupTimer);
      popupTimer = window.setTimeout(() => {
        popup.hidden = true;
      }, 4000);
    };

    const inCooldown = () => Number(localStorage.getItem(KEY) || '0') > Date.now();

    const preview =
      import.meta.env.DEV && new URLSearchParams(location.search).get('wave') === 'surfer';

    if (preview) {
      setCount(42);
      showRidingWave();
      if (status) status.textContent = 'Preview mode (dev only).';
      if (btn) {
        btn.removeAttribute('disabled');
        btn.addEventListener('click', () => showPopup());
      }
      return;
    }

    if (!api || !siteKey) {
      if (status) status.textContent = 'Wave counter is offline right now.';
      return;
    }

    if (!btn || !status) return;

    const idleLabel = (btn.textContent || 'Send a wave').trim();
    btn.removeAttribute('disabled');

    fetch(`${api}/count`)
      .then((r) => r.json())
      .then((d) => {
        setCount(Number(d.count) || 0);
        if (inCooldown()) showRidingWave();
      })
      .catch(() => setCount(0));

    // Runs once Turnstile produces a token (silently, or after a challenge).
    const send = async (token: string) => {
      try {
        const res = await fetch(`${api}/increment`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token }),
        });
        if (res.status === 200) {
          const d = await res.json();
          setCount(Number(d.count) || 0);
          showRidingWave();
          localStorage.setItem(KEY, String(Date.now() + COOLDOWN_MS));
          btn.textContent = 'Wave sent!';
          status.textContent = "Thanks so much for the wave! Have a 'swell day!";
        } else if (res.status === 429) {
          localStorage.setItem(KEY, String(Date.now() + COOLDOWN_MS));
          btn.textContent = 'Wave sent!';
          status.textContent = '';
          showPopup();
        } else {
          btn.textContent = idleLabel;
          btn.removeAttribute('disabled');
          status.textContent = 'Could not verify that wave. Please try again.';
        }
      } catch {
        btn.textContent = idleLabel;
        btn.removeAttribute('disabled');
        status.textContent = 'Network error. Please try again.';
      } finally {
        sending = false;
      }
    };

    // Render Turnstile hidden; it only shows a challenge if one is required.
    const renderWidget = () => {
      if (!w.turnstile || !(tsContainer instanceof HTMLElement) || widgetId !== null) return;
      widgetId = w.turnstile.render(tsContainer, {
        sitekey: siteKey,
        execution: 'execute',
        appearance: 'interaction-only',
        callback: (token: string) => send(token),
        'error-callback': () => {
          btn.textContent = idleLabel;
          btn.removeAttribute('disabled');
          status.textContent = 'Could not verify. Please try again.';
          sending = false;
        },
        'expired-callback': () => {},
      });
    };

    let tries = 0;
    const ready = window.setInterval(() => {
      tries += 1;
      if (w.turnstile && typeof w.turnstile.render === 'function') {
        window.clearInterval(ready);
        renderWidget();
      } else if (tries > 50) {
        window.clearInterval(ready);
      }
    }, 200);

    btn.addEventListener('click', () => {
      if (sending) return;
      if (inCooldown()) {
        showPopup();
        return;
      }
      if (!w.turnstile || widgetId === null) {
        status.textContent = 'Still loading, give it a second and try again.';
        return;
      }
      sending = true;
      btn.setAttribute('disabled', 'true');
      btn.textContent = 'Sending your wave...';
      status.textContent = '';
      w.turnstile.reset(widgetId);
      w.turnstile.execute(widgetId);
    });
  }

  document.addEventListener('astro:page-load', initWaveCounter);
</script>
