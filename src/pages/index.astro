---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import WaveCounter from '../components/WaveCounter.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
import { leadership } from '../data/leadership';
import { hackathons } from '../data/hackathons';
---

<Base>
  <div class="mx-auto w-full max-w-[38rem] px-6 pb-24">
    <p class="mt-8 text-[15px] leading-relaxed text-muted">{site.tagline}</p>

    <Section label="work">
      {
        experience.map((e) => (
          <Entry
            title={`${e.role} at`}
            link={{ text: e.company, href: e.href }}
            meta={e.summary}
            dates={e.dates}
            tags={e.tags}
          />
        ))
      }
    </Section>

    <Section label="leadership">
      {
        leadership.map((l) => (
          <Entry
            title={`${l.role},`}
            link={{ text: l.org, href: l.href }}
            meta={l.summary}
            dates={l.dates}
            tags={l.tags}
          />
        ))
      }
    </Section>

    <Section label="hackathons">
      {
        hackathons.map((h) => (
          <Entry
            title={h.project}
            meta={`${h.event}. ${h.summary}`}
            dates={h.placement ?? h.dates}
            tags={h.tags}
            links={h.links}
          />
        ))
      }
    </Section>

    <WaveCounter />
  </div>
</Base>
