---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Entry from '../components/Entry.astro';
import { site } from '../data/site';
import { experience } from '../data/experience';
---

<Base>
  <div class="mx-auto w-full max-w-[38rem] px-6 pb-24">
    <h1 class="mt-8 text-lg font-semibold tracking-tight">{site.name}</h1>
    <p class="mt-2 text-[15px] leading-relaxed text-slate-500">{site.tagline}</p>

    <Section label="work">
      {
        experience.map((e) => (
          <Entry
            title={`${e.role} at`}
            link={{ text: e.company, href: e.href }}
            meta={e.summary}
            dates={e.dates}
            tags={e.tags}
          />
        ))
      }
    </Section>
  </div>
</Base>
