---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page could not be found." noindex>
  <div class="mx-auto w-full max-w-[38rem] px-6 py-24">
    <h1 class="text-lg font-semibold tracking-tight text-ink">Page not found</h1>
    <p class="mt-2 text-sm leading-relaxed text-muted">That page does not exist or has moved.</p>
    <a href="/" class="mt-6 inline-block text-sm text-accent transition-colors hover:text-accent-dark"
      >Back to home</a
    >
  </div>
</Base>
