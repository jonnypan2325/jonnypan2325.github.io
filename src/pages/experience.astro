---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { experience } from '../data/experience';
---

<Base title="Experience">
  <div class="mx-auto w-full max-w-[38rem] px-6 pb-24">
    <h1 class="mt-8 text-lg font-semibold tracking-tight text-ink">Experience</h1>
    <p class="mt-2 text-sm leading-relaxed text-muted">Where I have worked.</p>
    <div class="mt-10 divide-y divide-rule">
      {
        experience.map((e) => (
          <Entry
            headingLevel={2}
            title={`${e.role} at`}
            link={{ text: e.company, href: e.href }}
            meta={e.summary}
            dates={e.dates}
            tags={e.tags}
          />
        ))
      }
    </div>
  </div>
</Base>
